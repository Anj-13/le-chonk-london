# Copy to .env and paste the event credits key. Without a key the app runs in mock mode.
MISTRAL_API_KEY=
# auto = live when a key is present, else mock. Force with mock | live.
CHONKVID_MODE=auto

# Model IDs: confirm with `python -m chonkvid check`, which lists what this key can use.
AGENT_MODEL=ministral-8b-latest
EMBED_MODEL=mistral-embed
# The WHO agent. Set to the Le Chonk model ID if the console lists one.
WHO_MODEL=mistral-large-latest

# Throughput: match the console rate limits.
MAX_CONCURRENCY=4
MISTRAL_RPS=2

# Detector threshold for mistral-embed cosine; `probe` prints a calibrated suggestion.
EMBED_THRESHOLD=0.86

# ---------------------------------------------------------------------------
# Optional Supabase persistence (Covid19-sim backend). Default is local-only:
# existing JSONL recordings keep working with none of these set.
# ---------------------------------------------------------------------------
# local | supabase
PERSISTENCE_BACKEND=local
# Which simulation model dashboard runs belong to until the architecture is final.
SIMULATION_TYPE=prompt_injection

# Supabase project (https://...). Required when PERSISTENCE_BACKEND=supabase.
SUPABASE_URL=
# Publishable/anon key - safe for browsers, constrained by RLS.
SUPABASE_ANON_KEY=
# SECRET service-role key - SERVER ONLY, bypasses RLS. Never commit or ship it.
SUPABASE_SERVICE_ROLE_KEY=

# Recommended for remote mirroring: use an existing matching project/scenario pair.
# Remote reads and mirroring require a signed-in Supabase user's access token.
# The shipped dashboard stays local; authorized WS clients can pass access_token
# in the first message or use the Authorization header.
# SUPABASE_PROJECT_ID=
# SUPABASE_SCENARIO_ID=
# Bootstrap values when the IDs above are omitted. For HTTP/WS bootstrap, provision
# a confirmed Auth account with this email and use its own access token.
# Authenticated mirror recordings go to the private/ subdirectory of the runs folder.
# SUPABASE_PROJECT_NAME=covid19-sim
# SUPABASE_SERVICE_EMAIL=system@covid19-sim.local
# SUPABASE_SERVICE_PASSWORD=
