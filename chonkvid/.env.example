# Copy to .env and paste the event credits key. Without a key the app runs in mock mode.
MISTRAL_API_KEY=
# auto = live when a key is present, else mock. Force with mock | live.
CHONKVID_MODE=auto

# Model IDs: confirm with `python -m chonkvid check`, which lists what this key can use.
AGENT_MODEL=ministral-8b-latest
EMBED_MODEL=mistral-embed
# The WHO agent: Le Chonk = Mistral Large 4 (mistral-large-latest is an alias of it).
WHO_MODEL=mistral-large-4

# WHO agent mode. chat = one completion with a pasted sitrep (the original path).
# agent = tools + JSON-schema structured output + the full outbreak log + the curve image.
WHO_MODE=chat
# full = every infected agent's message + each resisting agent's latest reply, in one request; sample = last 3 only.
WHO_CONTEXT=full
# 1 = also send a rendered PNG of the S/E/I/R curves to the vision encoder.
WHO_VISION=1
# Tool-calling rounds allowed before the final structured answer.
WHO_ROUNDS=2

# Throughput: match the console rate limits.
MAX_CONCURRENCY=4
MISTRAL_RPS=2

# Detector threshold for mistral-embed cosine; `probe` prints a calibrated suggestion.
EMBED_THRESHOLD=0.86

# Optional — persist results/runs to Supabase Postgres (percent-encode special chars in password).
# Project: ywglfnnbjefqirjjtbhb (region eu-central-1).
# Use the Supavisor pooler, not db.<ref>.supabase.co: the direct host is IPv6-only and
# fails to resolve on IPv4-only networks. Port 5432 = session mode, 6543 = transaction mode.
DATABASE_URL=postgresql://postgres.ywglfnnbjefqirjjtbhb:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require
# Or split fields (password stays out of the URL; percent-encoded automatically):
# SUPABASE_DB_HOST=aws-0-eu-central-1.pooler.supabase.com
# SUPABASE_DB_USER=postgres.ywglfnnbjefqirjjtbhb
# SUPABASE_DB_PASSWORD=
